# ============================================================================
# STICK Navigation System – Environment Configuration (.env)
# ============================================================================

# Optional: Google Maps Platform API Key
# If not supplied, STICK uses OpenStreetMap Carto + OSRM Pedestrian Routing out-of-the-box
# with ZERO blank maps.
# Required APIs: Maps SDK for Android, Places API, Routes API
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Firebase Realtime Database & Authentication Keys
# If not provided, STICK uses automatic local cross-tab broadcast synchronization
# allowing immediate dual-dashboard testing on localhost!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=stick-navigation.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stick-navigation
VITE_FIREBASE_STORAGE_BUCKET=stick-navigation.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://stick-navigation-default-rtdb.firebaseio.com
